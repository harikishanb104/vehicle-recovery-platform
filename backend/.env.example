# Copy this file to backend/.env.
# The project-local Postgres cluster listens on port 5433 and accepts
# local connections without a password. The Windows PostgreSQL service
# on port 5432 is left unchanged.
DATABASE_URL=postgresql+psycopg2://postgres@127.0.0.1:5433/vehicle_recovery
# Local demo only. Replace this before any shared or deployed environment.
JWT_SECRET=local-dev-secret-change-me
